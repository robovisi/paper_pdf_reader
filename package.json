{
  "name": "paper-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows-first desktop PDF reader for research papers",
  "author": "Paper Reader",
  "repository": {
    "type": "git",
    "url": "https://github.com/robovisi/paper_pdf_reader.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dictionary:build": "node scripts/build-dictionary.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "package:win": "pnpm exec electron --version && pnpm build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.paperreader.desktop",
    "productName": "Paper Reader",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "csv-parse": "^7.0.2",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0"
  }
}
